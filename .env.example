# .env.example
# =========================================================
# PURPOSE: Template biến môi trường — copy thành .env và điền giá trị thật.
#          File .env KHÔNG được commit lên Git (đã có trong .gitignore).
#          Trong production, tất cả secrets đọc từ HashiCorp Vault.
#
# HOW TO USE: cp .env.example .env
#
# LLM PROVIDER (chọn 1):
OPENAI_API_KEY=sk-proj-your-openai-key-here
OPENAI_BASE_URL=https://api.openai.com/v1
DEFAULT_MODEL_NAME=gpt-4o-mini
# --- DeepSeek alternative:
# OPENAI_API_KEY=sk-your-deepseek-key
# OPENAI_BASE_URL=https://api.deepseek.com/v1
# DEFAULT_MODEL_NAME=deepseek-chat
# --- Groq alternative:
# OPENAI_API_KEY=gsk_your-groq-key
# OPENAI_BASE_URL=https://api.groq.com/openai/v1
# DEFAULT_MODEL_NAME=llama-3.3-70b-versatile
# --- Local Ollama:
# OPENAI_API_KEY=ollama
# OPENAI_BASE_URL=http://localhost:11434/v1
# DEFAULT_MODEL_NAME=qwen2.5-coder:32b

# HASHICORP VAULT
VAULT_ADDR=http://vault:8200
VAULT_DEV_ROOT_TOKEN_ID=super-secret-vault-token

# POSTGRESQL
POSTGRES_DB=olist_db
POSTGRES_USER=admin
POSTGRES_PASSWORD=secure_postgres_pass_change_in_prod

# LANGFUSE (self-hosted - lấy từ http://localhost:3001 sau khi tạo project)
LANGFUSE_PUBLIC_KEY=pk-lf-your-public-key
LANGFUSE_SECRET_KEY=sk-lf-your-secret-key
LANGFUSE_HOST=http://langfuse-server:3000
LANGFUSE_NEXTAUTH_SECRET=random-32-char-string-for-langfuse
LANGFUSE_SALT=random-16-char-string-for-langfuse

# GOOGLE DRIVE (optional - cho Drive Skill)
# GOOGLE_SERVICE_ACCOUNT_JSON_PATH=/app/credentials/service-account.json
# =========================================================
